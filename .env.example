# Configurações do Banco de Dados MongoDB
# Se você tiver o MongoDB local instalado ou cluster Atlas, informe a URI abaixo.
# Exemplo local: mongodb://localhost:27017
# Exemplo Atlas: mongodb+srv://usuario:senha@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Nome do Banco de Dados
DB_NAME=banco_corporativo

# Porta da Aplicação Web
PORT=3000
